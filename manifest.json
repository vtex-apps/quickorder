{
  "vendor": "vtex",
  "name": "quickorder",
  "version": "3.16.10",
  "title": "Quickorder",
  "description": "Allow users to add multiple products to the cart at once",
  "defaultLocale": "en-US",
  "builders": {
    "messages": "1.x",
    "store": "0.x",
    "react": "3.x",
    "graphql": "1.x",
    "node": "6.x",
    "docs": "0.x"
  },
  "mustUpdateAt": "2019-04-02",
  "scripts": {
    "postreleasy": "bash lint.sh && vtex publish --verbose"
  },
  "credentialType": "absolute",
  "dependencies": {
    "vtex.flex-layout": "0.x",
    "vtex.rich-text": "0.x",
    "vtex.checkout": "0.x",
    "vtex.store": "2.x",
    "vtex.styleguide": "9.x",
    "vtex.store-graphql": "2.x",
    "vtex.search-graphql": "0.x",
    "vtex.checkout-graphql": "0.x",
    "vtex.apps-graphql": "2.x",
    "vtex.checkout-resources": "0.x",
    "vtex.order-manager": "0.x",
    "vtex.order-items": "0.x",
    "vtex.pixel-manager": "1.x",
    "vtex.store-resources": "0.x",
    "vtex.css-handles": "0.x",
    "vtex.store-icons": "0.x",
    "vtex.render-runtime": "8.x"
  },
  "policies": [
    {
      "name": "colossus-fire-event"
    },
    {
      "name": "colossus-write-logs"
    },
    {
      "name": "graphql-query"
    },
    {
      "name": "AcessaTodosCarrinhos"
    },
    {
      "name": "view-seller"
    },
    {
      "name": "outbound-access",
      "attrs": {
        "host": "portal.vtexcommercestable.com.br",
        "path": "/api/seller-register/pvt/sellers"
      }
    },
    {
      "name": "outbound-access",
      "attrs": {
        "host": "portal.vtexcommercestable.com.br",
        "path": "/api/catalog_system/pvt/sku/stockkeepingunitbyid/*"
      }
    },
    {
      "name": "outbound-access",
      "attrs": {
        "host": "portal.vtexcommercestable.com.br",
        "path": "/api/checkout/pub/orderForm/*"
      }
    },
    {
      "name": "outbound-access",
      "attrs": {
        "host": "portal.vtexcommercestable.com.br",
        "path": "/api/catalog_system/pub/sku/stockkeepingunitidsbyrefids"
      }
    }
  ],
  "settingsSchema": {
    "title": "Quickorder settings",
    "type": "object",
    "access": "public",
    "properties": {
      "checkoutUrl": {
        "title": "URL",
        "type": "string",
        "description": "Checkout redirect href",
        "default": "/checkout#/cart"
      },
      "uploadChunkSmallMaxRows": {
        "title": "Upload chunk: small file max rows",
        "type": "number",
        "description": "Files with this many rows or fewer are sent in a single add-to-cart request.",
        "default": 20
      },
      "uploadChunkMediumMaxRows": {
        "title": "Upload chunk: medium file max rows",
        "type": "number",
        "description": "Files with more than the small max and up to this many rows use the medium chunk size.",
        "default": 50
      },
      "uploadChunkLargeMaxRows": {
        "title": "Upload chunk: large file max rows",
        "type": "number",
        "description": "Files with more than the medium max and up to this many rows use the large chunk size. Larger files use the extra-large chunk size.",
        "default": 200
      },
      "uploadChunkMediumSize": {
        "title": "Upload chunk size for medium files",
        "type": "number",
        "description": "Number of items sent in each add-to-cart request for medium files.",
        "default": 10
      },
      "uploadChunkLargeSize": {
        "title": "Upload chunk size for large files",
        "type": "number",
        "description": "Number of items sent in each add-to-cart request for large files.",
        "default": 20
      },
      "uploadChunkXLargeSize": {
        "title": "Upload chunk size for extra-large files",
        "type": "number",
        "description": "Number of items sent in each add-to-cart request for files above the large max row threshold.",
        "default": 25
      }
    }
  },
  "billingOptions": {
    "termsURL": "https://compliance.vtex.com/gdpr/policies/vtex-privacy-policy",
    "support": {
      "url": "https://support.vtex.com/hc/requests"
    },
    "free": true,
    "type": "free",
    "availableCountries": ["*"]
  },
  "$schema": "https://raw.githubusercontent.com/vtex/node-vtex-api/master/gen/manifest.schema"
}
